{
  "info": {
    "name": "BountyPay demo",
    "description": "Signed GitHub merge webhooks for the BountyPay demo. Generated by `node scripts/demo.ts --postman` from demo/fixtures.json. Run the server with BOUNTYPAY_DEMO=1 and set webhookSecret to your GITHUB_WEBHOOK_SECRET.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "webhookSecret",
      "value": "bountypay-demo-secret"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const sig = CryptoJS.HmacSHA256(pm.request.body.raw, pm.collectionVariables.get('webhookSecret')).toString(CryptoJS.enc.Hex);",
          "pm.request.headers.upsert({ key: 'X-Hub-Signature-256', value: 'sha256=' + sig });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "PR #10: Fall back to defaults when the config file is empty",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-GitHub-Event",
            "value": "pull_request"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/github",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "github"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"action\":\"closed\",\"number\":10,\"pull_request\":{\"number\":10,\"merged\":true,\"title\":\"Fall back to defaults when the config file is empty\",\"body\":\"Fixes #1\\n\\nAn empty file parses to null, so merge it with the defaults instead.\\n\\nPayPal: sb-fx2ju53547833@personal.example.com\",\"html_url\":\"https://github.com/bountypay/demo/pull/10\",\"user\":{\"login\":\"demo-contributor\"}},\"repository\":{\"full_name\":\"bountypay/demo\"}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
