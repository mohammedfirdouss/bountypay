# Claude judges whether the merged diff resolves the issue.
ANTHROPIC_API_KEY=

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Only needed to receive payout status webhooks at /api/paypal (a public URL such as the Render deploy).
PAYPAL_WEBHOOK_ID=

# Shared secret of the GitHub repo webhook. The demo script signs with the same value.
GITHUB_WEBHOOK_SECRET=bountypay-demo-secret
# Token that can read issues and PRs and post comments on the bounty repo. Not needed in demo mode.
GITHUB_TOKEN=

# 1 = read issues and diffs from demo/fixtures.json and log comments instead of posting them.
# offline = the same, and Claude and PayPal are replaced by built-in stand-ins, so no keys are needed.
BOUNTYPAY_DEMO=1
# GitHub handles to mention on held bounties, comma-separated. Empty = the repo's CODEOWNERS * line
# (demo mode: the maintainers in demo/fixtures.json).
BOUNTYPAY_MAINTAINERS=
# SQLite file. Defaults to ./bountypay.db.
BOUNTYPAY_DB=
# When set, Approve and Reject ask for this token once per browser. Leave empty locally.
DASHBOARD_TOKEN=
